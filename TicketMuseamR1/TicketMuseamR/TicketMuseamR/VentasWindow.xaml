<Window x:Class="TicketMuseamR.VentasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TicketMuseum - Registro de Ventas" 
        WindowState="Maximized" 
        Background="#EAEAEA"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#005A9E" CornerRadius="0,15,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="3" Color="#999999"/>
            </Border.Effect>
            <Grid>
                <StackPanel Margin="0,40,0,0">
                    <Border CornerRadius="12" Background="#FFFFFF" Width="90" Height="90" Margin="0,0,0,15" Padding="8">
                        <Image Source="Assets/logo museo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="T I C K E T  M U S E U M" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <Button Content="🛒   Ventas" Background="#004578" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand"/>
                    <Button Content="📖   Bitácora" Background="Transparent" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand" Click="NavBitacora_Click"/>
                    <Button Content="⚙   Administración" Background="Transparent" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand" Click="NavAdmin_Click"/>
                </StackPanel>

                <Button Content="🚪   Cerrar Sesión" VerticalAlignment="Bottom" Background="Transparent" Foreground="#FFC107" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Margin="0,0,0,25" Cursor="Hand" Click="Logout_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10,10,0,30">
                <TextBlock Text="REGISTRO DE VENTAS" FontWeight="Bold" FontSize="36" Foreground="#005A9E"/>
                <TextBlock Text="Módulo para la venta de boletos e ingreso de visitantes" FontFamily="Arial" FontSize="14" Foreground="#666666" Margin="2,5,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="#FFFFFF" CornerRadius="12" MaxWidth="650" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="30" BorderBrush="#E0E0E0" BorderThickness="1" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15" Direction="270" ShadowDepth="3" Color="#CCCCCC"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Datos Grupo" FontWeight="Bold" FontSize="16" Foreground="#005A9E" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Nombre Responsable:" FontFamily="Arial" FontSize="12" Foreground="#333333" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtResponsable" Height="30" VerticalContentAlignment="Center" Padding="5,0,0,0" BorderBrush="#CCCCCC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Boletos:" FontFamily="Arial" FontSize="12" Foreground="#333333" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtCantidadBoletos" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="1" FontWeight="Bold" FontSize="14" BorderBrush="#CCCCCC"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="Fecha:" FontFamily="Arial" FontSize="12" Foreground="#333333" Margin="0,0,0,5"/>
                                <DatePicker Height="30" VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hora:" FontFamily="Arial" FontSize="12" Foreground="#333333" Margin="0,0,0,5"/>
                                <TextBox Height="30" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F5F5F5" Foreground="#666666" Text="10:00" Padding="5,0,0,0" BorderBrush="#CCCCCC"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#E0E0E0" Margin="0,0,0,25"/>

                        <TextBlock Text="Datos Venta" FontWeight="Bold" FontSize="16" Foreground="#005A9E" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Total:" FontFamily="Arial" FontSize="12" Foreground="#333333" Margin="0,0,0,5"/>
                                <TextBox x:Name="txtTotalVenta" Height="35" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F5F5F5" Foreground="#107C41" FontWeight="Bold" FontSize="18" Text="$ 50.00" Padding="5,0,0,0" BorderBrush="#CCCCCC"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Método de Pago:" FontFamily="Arial" FontSize="12" Foreground="#333333" Margin="0,0,0,5"/>
                                <ComboBox x:Name="cboMetodoPago" Height="35" VerticalContentAlignment="Center" Padding="8,0,0,0" BorderBrush="#CCCCCC">
                                    <ComboBoxItem Content="Efectivo" IsSelected="True"/>
                                    <ComboBoxItem Content="Tarjeta"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnRegistrar" Content="✔  Registrar" Grid.Column="0" Background="#107C41" Foreground="White" 
                                    FontWeight="Bold" FontSize="15" Height="45" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand"/>

                            <Button x:Name="BtnCancelar" Content="❌  Cancelar" Grid.Column="1" Background="#8B0000" Foreground="White" 
                                    FontWeight="Bold" FontSize="15" Height="45" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>