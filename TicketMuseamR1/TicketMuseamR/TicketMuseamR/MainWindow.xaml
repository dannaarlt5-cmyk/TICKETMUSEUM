<Window x:Class="TicketMuseamR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TicketMuseum" 
        WindowState="Maximized" 
        Background="#EAEAEA"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#005A9E" CornerRadius="0,15,15,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="0" ShadowDepth="3" Color="#999999"/>
            </Border.Effect>
            <Grid>
                <StackPanel Margin="0,40,0,0">
                    <Border CornerRadius="12" Background="#FFFFFF" Width="90" Height="90" Margin="0,0,0,15" Padding="8">
                        <Image Source="pack://application:,,,/Assets/logo museo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="T I C K E T  M U S E U M" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <Button Content="🏠   Inicio" Background="Transparent" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand" Click="NavInicio_Click"/>
                    <Button Content="🛒   Ventas" Background="Transparent" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand" Click="NavVentas_Click"/>
                    <Button Content="📖   Bitácora" Background="Transparent" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand" Click="NavBitacora_Click"/>
                    <Button Content="⚙   Administración" Background="Transparent" Foreground="White" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Cursor="Hand" Click="NavAdmin_Click"/>
                </StackPanel>

                <Button Content="🚪   Cerrar Sesión" VerticalAlignment="Bottom" Background="Transparent" Foreground="#FFC107" BorderThickness="0" Height="55" FontSize="15" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="25,0,0,0" Margin="0,0,0,25" Cursor="Hand" Click="Logout_Click"/>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" ContentRendered="MainFrame_ContentRendered"/>
    </Grid>
</Window>