<Window x:Class="TicketMuseamR.ReporteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista Previa del Corte de Caja" Height="700" Width="850" 
        WindowStartupLocation="CenterScreen" Background="#F4F4F4">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <DocumentViewer x:Name="dvVisor" Grid.Row="0" Background="#666666"/>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="BtnGuardar" Content="📄 Guardar como PDF" Background="#107C41" Foreground="White" 
        FontWeight="Bold" Width="180" Height="35" Margin="0,0,10,0" Cursor="Hand" Click="BtnGuardar_Click"/>

                <Button x:Name="BtnCerrar" Content="❌ Cerrar Vista" Background="#A80000" Foreground="White" 
                        FontWeight="Bold" Width="120" Height="35" Cursor="Hand" Click="BtnCerrar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
