<Window x:Class="TicketMuseamR.BitacoraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bitácora de Ingresos" Height="450" Width="650"
        WindowStartupLocation="CenterScreen" Background="#EAEAEA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#005A9E">
            <TextBlock Text="Bitácora" FontFamily="Segoe UI" FontWeight="Bold" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Buscar:" Grid.Column="0" FontFamily="Arial" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Grid.Column="1" Height="25" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

            <TextBlock Text="Fecha:" Grid.Column="2" FontFamily="Arial" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker Grid.Column="3" Height="25" Margin="0,0,10,0"/>

            <Button Content="🔍" Grid.Column="4" Width="35" Height="25" Background="#005A9E" Foreground="White" BorderThickness="0"/>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="5" Margin="15,0,15,15" BorderBrush="#CCCCCC" BorderThickness="1">
            <DataGrid x:Name="dgBitacora" AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowHeight="30">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F3F3F3"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5,10,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nombre Responsable" Binding="{Binding Nombre}" Width="2*"/>
                    <DataGridTextColumn Header="Grupo" Binding="{Binding CantidadPersonas}" Width="1*"/>
                    <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding FechaHora}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
