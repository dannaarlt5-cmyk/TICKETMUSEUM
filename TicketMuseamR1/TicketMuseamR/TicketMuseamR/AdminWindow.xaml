<Window x:Class="TicketMuseamR.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administración - Cierre de Caja" Height="480" Width="450"
        WindowStartupLocation="CenterScreen" Background="#EAEAEA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#005A9E">
            <TextBlock Text="Administración" FontFamily="Segoe UI" FontWeight="Bold" FontSize="20" Foreground="White" VerticalAlignment="Center" Margin="15,0,0,0"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="25" VerticalAlignment="Top">
            <TextBlock Text="CIERRE DE CAJA" FontFamily="Segoe UI" FontWeight="Bold" FontSize="18" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,20">
                <TextBlock Text="Fecha: 29/04/2026" FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left"/>
                <TextBlock Text="Hora: 17:45" FontFamily="Arial" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>

            <Border Background="White" CornerRadius="5" Padding="20" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Monto Total Recaudado:" FontFamily="Arial" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="$ 3,580.50" FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#005A9E"/>
                    </Grid>
                    <Separator Background="#CCCCCC" Margin="0,5,0,10"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Efectivo:" FontFamily="Arial" FontSize="13" Foreground="Gray"/>
                        <TextBlock Text="$ 3,580.50" FontFamily="Arial" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Tarjeta:" FontFamily="Arial" FontSize="13" Foreground="Gray"/>
                        <TextBlock Text="$ 3,580.50" FontFamily="Arial" FontSize="13" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⚠ " Foreground="#F57F17" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Verifique que el efectivo coincida antes de cerrar" FontFamily="Arial" FontSize="12" FontWeight="Bold" Foreground="#F57F17" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Button Content="🖨 Imprimir" Grid.Column="0" Background="#007ACC" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold" Height="35" Margin="0,0,8,0" BorderThickness="0"/>

                <Button Content="💲 Cerrar Caja" Grid.Column="1" Background="#107C41" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold" Height="35" Margin="0,0,8,0" BorderThickness="0"/>

                <Button Content="↩ Volver" Grid.Column="2" Background="#A80000" Foreground="White" FontFamily="Segoe UI" FontWeight="Bold" Height="35" BorderThickness="0"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>